{
  "name": "codex-go",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/host/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "start": "tsx src/host/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "probe": "tsx tools/probe.ts",
    "probe:desktop": "tsx tools/desktop-probe.ts",
    "protocol": "tsx tools/protocol.ts",
    "build:native": "npm run build && node tools/build-native.mjs",
    "build:windows": "npm run build && node tools/build-native.mjs --windows && node tools/package-windows.mjs",
    "build:runtime": "python tools/build-runtime.py"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "fastify": "^5.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "overrides": {
    "glob": "^14.0.3"
  }
}
